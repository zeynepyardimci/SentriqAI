<!-- Sentriq In-Page GUI Agent (Page-Agent Paradigm) -->
<div id="page-agent-container" style="position: fixed; bottom: 20px; right: 24px; z-index: 9999; font-family: var(--font-sans, system-ui);">
  <!-- Trigger Button (Floating Agent Orb) -->
  <button id="page-agent-trigger" onclick="togglePageAgent()" style="display: flex; align-items: center; gap: 0.65rem; background: linear-gradient(135deg, #06b6d4 0%, #8b5cf6 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.25); border-radius: 9999px; padding: 0.65rem 1.25rem; font-weight: 600; font-size: 0.85rem; box-shadow: 0 10px 25px -5px rgba(6, 182, 212, 0.5), 0 8px 10px -6px rgba(139, 92, 246, 0.4); cursor: pointer; transition: all 0.25s ease;">
    <span style="font-size: 1.1rem; animation: pulse 2s infinite;">🤖</span>
    <span>Page-Agent</span>
    <span style="font-size: 0.7rem; background: rgba(0,0,0,0.35); padding: 0.2rem 0.5rem; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.2);">Ragie RAG</span>
  </button>

  <!-- Page Agent Modal / HUD Drawer -->
  <div id="page-agent-hud" style="display: none; width: 440px; max-width: 90vw; max-height: 85vh; background: rgba(15, 23, 42, 0.96); backdrop-filter: blur(16px); border: 1px solid rgba(6, 182, 212, 0.4); border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); overflow: hidden; margin-top: 10px; display: none; flex-direction: column;">
    
    <!-- HUD Header -->
    <div style="background: linear-gradient(90deg, rgba(6, 182, 212, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%); padding: 0.85rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.2rem;">🤖</span>
        <div>
          <div style="font-weight: 700; font-size: 0.95rem; color: #38bdf8; display: flex; align-items: center; gap: 0.5rem;">
            PAGE-AGENT
            <span style="font-size: 0.65rem; background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #10b981; padding: 0.1rem 0.4rem; border-radius: 4px;">In-Page GUI</span>
          </div>
          <div style="font-size: 0.7rem; color: #94a3b8;">Autonomous DOM Observer & Ragie RAG Executor</div>
        </div>
      </div>
      <button onclick="togglePageAgent()" style="background: none; border: none; color: #94a3b8; font-size: 1.25rem; cursor: pointer; padding: 0.25rem;">&times;</button>
    </div>

    <!-- Live Page Context Observation Bar -->
    <div style="background: rgba(0, 0, 0, 0.4); padding: 0.65rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 0.75rem;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
        <span style="color: #64748b; text-transform: uppercase; font-weight: 600;">Gözlemlenen Sayfa DOM'u:</span>
        <span id="pa-page-url" style="color: #38bdf8; font-family: monospace;"></span>
      </div>
      <div id="pa-page-detection" style="color: #e2e8f0; font-size: 0.8rem; font-weight: 500;">
        Sayfa taranıyor...
      </div>
    </div>

    <!-- Active Engines Status -->
    <div style="display: flex; gap: 0.5rem; padding: 0.5rem 1.25rem; background: rgba(2, 6, 23, 0.4); border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.7rem;">
      <div style="color: #94a3b8;">
        Reasoning: <strong style="color: #a78bfa;"><%= ENV["GROK_API_KEY"].present? ? "Grok (xAI) Live" : (ENV["OPENAI_API_KEY"].present? ? "OpenAI Live" : "Contextual Local Engine") %></strong>
      </div>
      <span style="color: #475569;">&bull;</span>
      <div style="color: #94a3b8;">
        RAG: <strong style="color: #22d3ee;"><%= ENV["RAGIE_API_KEY"].present? ? "Ragie.ai Cloud" : "Ragie Local Knowledge" %></strong>
      </div>
    </div>

    <!-- Scrollable Execution & Interaction Area -->
    <div style="padding: 1.25rem; overflow-y: auto; max-height: 48vh; display: flex; flex-direction: column; gap: 1rem;">
      
      <!-- Quick Action Buttons -->
      <div>
        <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: #64748b; margin-bottom: 0.5rem;">
          Hızlı Otonom Komutlar (Sıfır İnsan Müdahalesi):
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <button onclick="runPageAgentCommand('Bu tespiti incele, otomatik ticket aç, Ragie RAG\'e sor ve sıfır insan müdahalesiyle raporlayıp çöz.')" style="background: rgba(6, 182, 212, 0.12); border: 1px solid rgba(6, 182, 212, 0.4); color: #38bdf8; border-radius: 6px; padding: 0.5rem 0.75rem; font-size: 0.8rem; text-align: left; cursor: pointer; transition: background 0.15s ease;">
            ⚡ <strong>Otonom Ticket Aç & Ragie ile Raporla</strong>
            <div style="font-size: 0.7rem; color: #94a3b8; margin-top: 0.15rem;">Bilet açar, Ragie runbook'u bağlar ve insan beklemeden çözer.</div>
          </button>
          
          <button onclick="runPageAgentCommand('Ragie RAG bilgi tabanında bu sayfadaki tehdit için ilgili acil müdahale prosedürlerini ara.')" style="background: rgba(139, 92, 246, 0.12); border: 1px solid rgba(139, 92, 246, 0.4); color: #c084fc; border-radius: 6px; padding: 0.5rem 0.75rem; font-size: 0.8rem; text-align: left; cursor: pointer; transition: background 0.15s ease;">
            📚 <strong>Ragie RAG Runbook Sorgula</strong>
            <div style="font-size: 0.7rem; color: #94a3b8; margin-top: 0.15rem;">Doğrudan Ragie.ai API üzerinden runbook ve kanıt parçaları çeker.</div>
          </button>
        </div>
      </div>

      <!-- Execution Trace (Re-Act Loop Feed) -->
      <div id="pa-feed-container" style="display: none; background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; padding: 0.75rem;">
        <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: #38bdf8; margin-bottom: 0.5rem; display: flex; justify-content: space-between;">
          <span>Page-Agent Yürütme Akışı (Observe ➔ Think ➔ Act):</span>
          <span id="pa-status-badge" style="color: #34d399;">Çalışıyor...</span>
        </div>
        <div id="pa-steps-log" style="font-family: monospace; font-size: 0.75rem; color: #cbd5e1; display: flex; flex-direction: column; gap: 0.35rem; max-height: 180px; overflow-y: auto;">
        </div>
      </div>

      <!-- Result Card -->
      <div id="pa-result-card" style="display: none; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 6px; padding: 0.75rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
          <strong style="color: #34d399; font-size: 0.85rem;">İşlem Tamamlandı (Sıfır İnsan Müdahalesi)</strong>
          <span id="pa-ticket-badge" class="badge" style="background: rgba(6, 182, 212, 0.2); color: #38bdf8;"></span>
        </div>
        <p id="pa-result-summary" style="font-size: 0.75rem; color: #e2e8f0; margin-bottom: 0.5rem;"></p>
        <a id="pa-ticket-link" href="#" class="btn btn-primary" style="display: inline-block; font-size: 0.75rem; padding: 0.35rem 0.75rem; text-decoration: none;">
          Oluşturulan Bileti & Raporu Aç &rarr;
        </a>
      </div>
    </div>

    <!-- Natural Language Command Input -->
    <div style="padding: 0.85rem 1.25rem; background: rgba(0, 0, 0, 0.4); border-top: 1px solid rgba(255,255,255,0.08);">
      <form onsubmit="submitPageAgentCustom(event)" style="display: flex; gap: 0.5rem;">
        <input type="text" id="pa-custom-input" placeholder="Örn: Bu tespiti incele, otomatik ticket aç, RAG'e sor ve raporla..." style="flex: 1; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; padding: 0.5rem 0.75rem; color: #ffffff; font-size: 0.8rem; outline: none;">
        <button type="submit" id="pa-submit-btn" style="background: #06b6d4; color: #000000; border: none; border-radius: 6px; padding: 0.5rem 1rem; font-weight: 600; font-size: 0.8rem; cursor: pointer;">
          Çalıştır
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function togglePageAgent() {
    const hud = document.getElementById("page-agent-hud");
    const isHidden = hud.style.display === "none" || hud.style.display === "";
    hud.style.display = isHidden ? "flex" : "none";
    if (isHidden) {
      observeCurrentPageDOM();
    }
  }

  function observeCurrentPageDOM() {
    const pageUrlElem = document.getElementById("pa-page-url");
    const pageDetElem = document.getElementById("pa-page-detection");
    
    pageUrlElem.innerText = window.location.pathname;

    // In-Page DOM extraction (Observe phase)
    const titleHeader = document.querySelector("h1, .page-header-title");
    const hostElement = document.querySelector(".telemetry-value, [data-hostname]");
    const processElement = document.querySelector(".tree-node.target strong, [data-process]");

    let desc = "Sentriq AI Güvenlik Paneli";
    if (window.location.pathname.includes("/detections/")) {
      const match = window.location.pathname.match(/\/detections\/(\d+)/);
      const detId = match ? match[1] : "";
      desc = `Tespit #${detId}: ${titleHeader ? titleHeader.innerText.trim() : 'Aktif Güvenlik Uyarısı'}`;
    } else if (window.location.pathname.includes("/tickets")) {
      desc = "Agent Biletleri & SOC İnceleme Listesi";
    }

    pageDetElem.innerText = desc;
  }

  function getPageContext() {
    const context = {
      url: window.location.pathname,
      title: document.title
    };

    const match = window.location.pathname.match(/\/detections\/(\d+)/);
    if (match) {
      context.detection_id = parseInt(match[1], 10);
    }

    const hostElem = document.querySelector(".telemetry-item:nth-child(1) .telemetry-value");
    if (hostElem) context.hostname = hostElem.innerText.trim();

    return context;
  }

  async function runPageAgentCommand(instruction) {
    const feed = document.getElementById("pa-feed-container");
    const log = document.getElementById("pa-steps-log");
    const statusBadge = document.getElementById("pa-status-badge");
    const resultCard = document.getElementById("pa-result-card");
    const submitBtn = document.getElementById("pa-submit-btn");

    feed.style.display = "block";
    resultCard.style.display = "none";
    log.innerHTML = "";
    statusBadge.innerText = "Yürütülüyor...";
    statusBadge.style.color = "#38bdf8";
    if (submitBtn) submitBtn.disabled = true;

    // Step 1: Client-Side Observe
    appendLog("👁️ OBSERVE", `Sayfa DOM verileri toplandı (URL: ${window.location.pathname}).`);

    try {
      const response = await fetch("/page_agent/execute", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || ""
        },
        body: JSON.stringify({
          instruction: instruction,
          page_url: window.location.pathname,
          page_context: getPageContext(),
          human_intervention: false
        })
      });

      const data = await response.json();

      if (data.steps && data.steps.length > 0) {
        data.steps.forEach(step => {
          const icon = step.phase === "observe" ? "👁️ OBSERVE" : (step.phase === "think" ? "🧠 THINK" : "⚡ ACT");
          appendLog(icon, step.message);
        });
      }

      if (data.success && data.ticket) {
        statusBadge.innerText = "Tamamlandı";
        statusBadge.style.color = "#34d399";

        resultCard.style.display = "block";
        document.getElementById("pa-ticket-badge").innerText = data.ticket.ticket_number + " (" + data.ticket.status + ")";
        document.getElementById("pa-result-summary").innerText = `Bilet ${data.ticket.ticket_number} başarıyla açıldı, Ragie RAG [${data.ragie_provider}] runbook'ları bağlandı ve sıfır insan müdahalesiyle çözüldü.`;
        
        const link = document.getElementById("pa-ticket-link");
        link.href = data.ticket.url;
        link.innerText = `${data.ticket.ticket_number} Raporunu Aç &rarr;`;
      } else {
        statusBadge.innerText = "Hata";
        statusBadge.style.color = "#ef4444";
        appendLog("❌ HATA", data.error || "İşlem tamamlanamadı.");
      }
    } catch (err) {
      statusBadge.innerText = "Hata";
      statusBadge.style.color = "#ef4444";
      appendLog("❌ HATA", err.message);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  }

  function appendLog(phase, message) {
    const log = document.getElementById("pa-steps-log");
    const div = document.createElement("div");
    div.style.padding = "2px 0";
    div.innerHTML = `<strong style="color: #38bdf8;">[${phase}]</strong> ${escapeHtml(message)}`;
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
  }

  function escapeHtml(text) {
    const div = document.createElement("div");
    div.innerText = text;
    return div.innerHTML;
  }

  function submitPageAgentCustom(e) {
    e.preventDefault();
    const input = document.getElementById("pa-custom-input");
    const val = input.value.trim();
    if (!val) return;
    runPageAgentCommand(val);
    input.value = "";
  }
</script>
