<% content_for :title, "#{@ticket.ticket_number}: #{@ticket.title} | Sentriq AI" %>

<!-- Breadcrumb -->
<div style="margin-bottom: 1rem; font-size: 0.85rem; color: var(--text-muted);">
  <%= link_to "Agent Tickets", tickets_path %> &rarr;
  <span style="color: var(--text-secondary);"><%= @ticket.ticket_number %></span>
</div>

<!-- Header -->
<div class="detail-header">
  <div class="detail-header-top">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
        <span style="font-family: var(--font-mono); font-weight: 700; color: var(--cyan-primary);"><%= @ticket.ticket_number %></span>
        <span class="badge badge-<%= @ticket.priority %>"><%= @ticket.priority %></span>
        <span class="badge badge-status-<%= @ticket.status %>"><%= @ticket.status.humanize %></span>
        <% if @ticket.status == "pending_review" %>
          <span class="badge badge-sla-risk">Handed Over to Human</span>
        <% end %>
      </div>
      <h1 class="detail-title"><%= @ticket.title %></h1>
      <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6;"><%= @ticket.description %></p>
    </div>

    <div>
      <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Originating Agent</div>
      <div style="font-weight: 600; color: #38bdf8; font-family: var(--font-mono);"><%= @ticket.assigned_agent || "External SOAR Agent" %></div>
    </div>
  </div>

  <div class="telemetry-strip">
    <div class="telemetry-item">
      <span class="telemetry-label">Created At</span>
      <span class="telemetry-value"><%= @ticket.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
    </div>
    <div class="telemetry-item">
      <span class="telemetry-label">Idempotency Key</span>
      <span class="telemetry-value"><%= @ticket.idempotency_key || "None (adhoc)" %></span>
    </div>
    <div class="telemetry-item">
      <span class="telemetry-label">Linked Detection</span>
      <span class="telemetry-value">
        <% if @ticket.detection %>
          <%= link_to "#{@ticket.detection.hostname} (#{@ticket.detection.severity})", detection_path(@ticket.detection) %>
        <% else %>
          None (Independent Event)
        <% end %>
      </span>
    </div>
    <div class="telemetry-item">
      <span class="telemetry-label">Human Review Status</span>
      <span class="telemetry-value">
        <%= @ticket.human_decision.present? ? @ticket.human_decision.humanize : (@ticket.status == "pending_review" ? "Awaiting Analyst Decision" : "Auto/Agent Handled") %>
      </span>
    </div>
  </div>
</div>

<!-- Two Column Layout: Left = Context & Notes / Right = Contextual LLM Decision & Human Review -->
<div class="triage-grid">
  <!-- LEFT COLUMN: Ticket History & Notes -->
  <div>
    <!-- Linked Detection Details (if any) -->
    <% if @ticket.detection %>
      <div class="panel-card">
        <div class="panel-title">
          <span>Linked Detection Telemetry</span>
          <%= link_to "Open Full Detection &rarr;".html_safe, detection_path(@ticket.detection), style: "font-size: 0.75rem;" %>
        </div>
        <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
          <strong><%= @ticket.detection.title %></strong> on <code style="color: var(--cyan-primary);"><%= @ticket.detection.hostname %></code>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.75rem; background: rgba(0,0,0,0.3); padding: 0.75rem; border-radius: var(--radius-sm); color: #38bdf8; word-break: break-all; margin-bottom: 0.75rem;">
          Process: <%= @ticket.detection.process_name %> (PID: <%= @ticket.detection.process_id %>)<br>
          Parent: <%= @ticket.detection.parent_process_name || "N/A" %><br>
          Command: <%= @ticket.detection.command_line %>
        </div>
        <% if @ticket.detection.evidences.any? %>
          <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.35rem; font-weight: 600; text-transform: uppercase;">Correlated Evidences (<%= @ticket.detection.evidences.count %>)</div>
          <ul class="bullet-list">
            <% @ticket.detection.evidences.chronological.each do |ev| %>
              <li class="bullet-item">[<%= ev.evidence_type.humanize %>] <%= ev.description %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <!-- Notes & Agent Findings Timeline -->
    <div class="panel-card">
      <div class="panel-title">
        <span>Ticket Notes & Agent Activity (<%= @notes.count %>)</span>
        <span style="font-size: 0.75rem; color: var(--text-muted);">Communication Log</span>
      </div>

      <% if @notes.any? %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% @notes.each do |note| %>
            <div style="background: rgba(0,0,0,0.25); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.85rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <div>
                  <strong style="color: <%= note.author_type == 'agent' ? 'var(--cyan-primary)' : '#10b981' %>;">
                    <%= note.author_name %>
                  </strong>
                  <span class="badge badge-low" style="margin-left: 0.4rem;"><%= note.note_type.humanize %></span>
                </div>
                <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);"><%= time_ago_in_words(note.created_at) %> ago</span>
              </div>
              <div style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.5; white-space: pre-line;"><%= note.body %></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color: var(--text-muted); font-size: 0.85rem;">No notes recorded yet on this ticket.</p>
      <% end %>

      <!-- Add Manual Note Form -->
      <div style="margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
        <%= form_with url: add_note_ticket_path(@ticket), method: :post, local: true do |f| %>
          <div style="margin-bottom: 0.75rem;">
            <%= f.text_area :body, rows: 2, placeholder: "Add an analyst comment or note...", class: "input-control", style: "width: 100%; resize: vertical;" %>
          </div>
          <%= f.submit "Post Comment", class: "btn btn-secondary", style: "font-size: 0.8rem; padding: 0.35rem 0.75rem;" %>
        <% end %>
      </div>
    </div>

    <!-- Audit Events for Ticket -->
    <div class="panel-card">
      <div class="panel-title">
        <span>Ticket Audit Trail</span>
      </div>
      <% if @audit_events.any? %>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <% @audit_events.each do |audit| %>
            <div style="font-size: 0.8rem; padding: 0.5rem 0.75rem; background: rgba(0,0,0,0.2); border-radius: var(--radius-sm); display: flex; justify-content: space-between;">
              <div>
                <strong style="color: var(--cyan-primary);"><%= audit.action.humanize %></strong>
                <% if audit.user %><span style="color: var(--text-muted);"> by <%= audit.user.name %></span><% end %>
                <% if audit.details.present? %>
                  <span style="color: var(--text-secondary); margin-left: 0.5rem;"><%= audit.details.to_json %></span>
                <% end %>
              </div>
              <span style="font-family: var(--font-mono); color: var(--text-muted); font-size: 0.75rem;"><%= time_ago_in_words(audit.created_at) %> ago</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color: var(--text-muted); font-size: 0.85rem;">No audit events recorded.</p>
      <% end %>
    </div>
  </div>

  <!-- RIGHT COLUMN: LLM Contextual Decision & Human Review Panel -->
  <div>
    <!-- LLM Contextual Decision Card -->
    <% if @ticket.llm_analysis.present? && @ticket.llm_analysis.any? %>
      <% analysis = @ticket.llm_analysis %>
      <div class="panel-card ai-report-card">
        <div class="panel-title">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2">
              <path d="M12 2a10 10 0 1 0 10 10H12V2z"/>
              <path d="M12 12L2.5 7.5"/>
            </svg>
            <span style="color: #c084fc;">LLM Contextual Decision Engine</span>
          </div>
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <span class="badge" style="background: rgba(139, 92, 246, 0.2); color: #c084fc; border: 1px solid #8b5cf6;">
              <%= @ticket.agent_mode == 'live_llm' ? 'Live LLM Provider' : 'Simulated Contextual Engine' %>
            </span>
            <span class="badge" style="background: rgba(6, 182, 212, 0.2); color: #22d3ee; border: 1px solid var(--cyan-primary);">
              Confidence: <%= analysis["confidence"] %>%
            </span>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
          <div style="background: rgba(0,0,0,0.3); padding: 0.75rem; border-radius: var(--radius-sm);">
            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Evaluated Intent</div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 0.9rem;"><%= analysis["intent"]&.humanize %></div>
          </div>
          <div style="background: rgba(0,0,0,0.3); padding: 0.75rem; border-radius: var(--radius-sm);">
            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Determined Priority</div>
            <div style="font-weight: 600; font-size: 0.9rem;">
              <span class="badge badge-<%= analysis["priority"] %>"><%= analysis["priority"]&.upcase %></span>
            </div>
          </div>
        </div>

        <!-- Rationale -->
        <div class="ai-summary-box">
          <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: #a78bfa; margin-bottom: 0.35rem;">Contextual Rationale (Anlamsal Gerekçe)</div>
          <%= analysis["rationale"] %>
        </div>

        <!-- Recommended Action -->
        <div style="margin-bottom: 1rem;">
          <div class="section-subtitle">Önerilen Sonraki Eylem (Recommended Action)</div>
          <div style="background: rgba(6, 182, 212, 0.1); border-left: 3px solid var(--cyan-primary); padding: 0.75rem 1rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 0.85rem; color: #38bdf8;">
            <%= analysis["recommended_action"] %>
          </div>
        </div>

        <!-- RAG Citations -->
        <div class="section-subtitle">Doğrulanmış RAG Bilgi Kaynakları (Verified Runbooks)</div>
        <% if (analysis["source_refs"] || []).any? %>
          <% analysis["source_refs"].each do |ref| %>
            <div class="source-ref-card">
              <div class="source-ref-title">
                <span><%= ref["document_title"] %> (<%= ref["category"]&.humanize %>)</span>
                <% if ref["document_id"].present? %>
                  <%= link_to "Dokümanı Aç &rarr;".html_safe, knowledge_document_path(ref["document_id"]), style: "font-size: 0.75rem;" %>
                <% end %>
              </div>
              <div class="source-ref-quote">"<%= ref["quote"] %>"</div>
              <div class="source-ref-relevance">&rarr; <%= ref["relevance_explanation"] %></div>
            </div>
          <% end %>
        <% else %>
          <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); padding: 0.75rem; border-radius: var(--radius-sm); font-size: 0.8rem; color: #fbbf24;">
            <strong>Kaynak bulunamadı:</strong> Bilgi tabanında bu olay için eşleşen bir prosedür dokümanı bulunmamaktadır. Model kaynaksız varsayım üretmemiştir.
          </div>
        <% end %>

        <!-- Limitations -->
        <% if analysis["limitations"].present? %>
          <div style="margin-top: 1rem; padding: 0.65rem 0.85rem; background: rgba(0,0,0,0.3); border-radius: var(--radius-sm); font-size: 0.75rem; color: var(--text-muted);">
            <%= analysis["limitations"] %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Human-in-the-Loop Decision Panel -->
    <div class="panel-card" style="border: 1px solid <%= @ticket.human_decision.present? ? 'rgba(16, 185, 129, 0.4)' : 'rgba(245, 158, 11, 0.4)' %>;">
      <div class="panel-title">
        <span>İnsan Analist Kararı (Human-in-the-Loop)</span>
        <span class="badge badge-status-<%= @ticket.status %>"><%= @ticket.status.humanize %></span>
      </div>

      <% if @ticket.human_decision.present? %>
        <!-- Already Reviewed View -->
        <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1rem;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
            <strong style="color: #34d399; font-size: 0.95rem;">Karar: <%= @ticket.human_decision.humanize %></strong>
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);"><%= @ticket.human_reviewed_at&.strftime("%Y-%m-%d %H:%M:%S") %></span>
          </div>
          <div style="font-size: 0.85rem; color: var(--text-primary); margin-bottom: 0.5rem;"><%= @ticket.human_decision_notes %></div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">
            İnceleyen Analist: <strong><%= @ticket.human_reviewer&.name %></strong> (<%= @ticket.human_reviewer&.role&.humanize %>)
          </div>
        </div>
      <% end %>

      <!-- Decision Action Form -->
      <%= form_with url: review_ticket_path(@ticket), method: :post, local: true do |f| %>
        <div style="margin-bottom: 1rem;">
          <%= f.label :notes, "Analist Karar Gerekçesi / Notu", style: "display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem;" %>
          <%= f.text_area :notes, rows: 3, placeholder: "Örn: Güvenlik aksiyonu onaylandı; ağ karantinası uygulandı / Yanlış alarm tespit edildi...", class: "input-control", style: "width: 100%; resize: vertical;" %>
        </div>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <%= f.button "Öneriyi Onayla ve Çözüldü İşaretle (Approve)", name: "decision", value: "approved", class: "btn btn-success" %>
          <%= f.button "Daha Fazla Kanıt İste (Request Changes)", name: "decision", value: "request_changes", class: "btn btn-secondary" %>
          <%= f.button "Kapat / Reddet (Dismiss)", name: "decision", value: "dismissed", class: "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
