<% content_for :title, "Switch Analyst Persona | Sentriq AI" %>

<div style="max-width: 600px; margin: 2rem auto;">
  <div class="panel-card">
    <div class="panel-title">
      <span>Controlled Demo Personas</span>
      <span style="font-size: 0.75rem; color: var(--text-muted);">Role-Based Simulation</span>
    </div>

    <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
      Test human-in-the-loop triage flows from different perspectives: Level 1 Analyst (triage & investigation), Senior Analyst, or Lead Analyst (incident approval & escalation).
    </p>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% @users.each do |user| %>
        <div style="background: rgba(0,0,0,0.25); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div style="font-weight: 600; color: var(--text-primary); font-size: 0.95rem;"><%= user.name %></div>
            <div style="font-size: 0.8rem; color: var(--text-muted);"><%= user.email %></div>
            <div style="margin-top: 0.25rem;">
              <span class="badge badge-status-open"><%= user.role.humanize %></span>
            </div>
          </div>

          <%= form_with url: session_path, method: :post, local: true do |f| %>
            <%= f.hidden_field :user_id, value: user.id %>
            <%= f.submit "Select #{user.role.humanize}", class: "btn btn-primary", style: "padding: 0.4rem 0.85rem; font-size: 0.8rem;" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
