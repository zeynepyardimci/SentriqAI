<% content_for :title, "SOC Compliance Audit Trail | Sentriq AI" %>

<div style="margin-bottom: 1.5rem;">
  <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">Security Operations Audit Trail</h1>
  <p style="color: var(--text-secondary); font-size: 0.9rem;">Immutable log of detection state transitions, AI investigations, SLA breaches, and analyst human review decisions.</p>
</div>

<div class="table-container">
  <table class="data-table">
    <thead>
      <tr>
        <th>Timestamp</th>
        <th>Action</th>
        <th>Target Entity</th>
        <th>User / Operator</th>
        <th>Event Details</th>
      </tr>
    </thead>
    <tbody>
      <% @audit_events.each do |event| %>
        <tr>
          <td>
            <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-secondary);">
              <%= event.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
            </span>
          </td>
          <td>
            <span class="badge" style="background: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3);">
              <%= event.action.humanize %>
            </span>
          </td>
          <td>
            <% if event.trackable.is_a?(Detection) %>
              <%= link_to "#{event.trackable_type} ##{event.trackable_id}", detection_path(event.trackable) %>
            <% elsif event.trackable.is_a?(Investigation) %>
              <%= link_to "#{event.trackable_type} ##{event.trackable_id}", detection_path(event.trackable.detection) %>
            <% else %>
              <%= event.trackable_type %> #<%= event.trackable_id %>
            <% end %>
          </td>
          <td>
            <% if event.user %>
              <strong style="color: var(--text-primary); font-size: 0.85rem;"><%= event.user.name %></strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= event.user.role.humanize %></div>
            <% else %>
              <span style="color: var(--text-muted); font-size: 0.8rem; font-style: italic;">Automated System / SLA Monitor</span>
            <% end %>
          </td>
          <td>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); max-width: 450px; word-break: break-all;">
              <%= event.details.to_json %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
