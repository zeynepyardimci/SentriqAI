# Sentriq AI - Environment Configuration Example (NO SECRETS)

# Application & Database Settings
RAILS_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sentriq_ai_development

# In Production (e.g. Render / Heroku):
# DATABASE_URL=postgresql://user:pass@host:5432/sentriq_ai_production
# RAILS_MASTER_KEY=<your_production_master_key>
# RAILS_SERVE_STATIC_FILES=true

# Optional Live AI Investigation LLM Providers
# If neither key is provided, Sentriq AI automatically activates the
# built-in deterministic simulated local engine and clearly tags reports as simulated.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash
